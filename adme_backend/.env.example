# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.7.4
LOG_LEVEL=INFO

# Database
DB_NAME=adme_db
DB_USER=adme_user
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=3306

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# CORS — Expo web (Metro) dev server origin(s), comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Object storage (B3 / ADR 0002) — leave USE_S3=False for local dev
USE_S3=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# WhatsApp Business API (ADR 0004 — provider TBD)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# Email
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Maps (ADR 0005 — Google Maps vs Mapbox)
GOOGLE_MAPS_API_KEY=
